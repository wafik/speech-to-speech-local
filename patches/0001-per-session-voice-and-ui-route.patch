+# ── Caller auth ──────────────────────────────────────────────────────
+# SPEECH_WS_TOKEN gates the realtime socket and the read-only JSON routes.
+# Empty/unset means "no token configured": the server is assumed to be
+# reachable only from this machine (127.0.0.1) or behind an external gate.
+# A tunnel publishes a hostname to the whole internet, so set it before
+# `make tunnel`.
+_WS_TOKEN_ENV = "SPEECH_WS_TOKEN"
+
+
+def _ws_token() -> str:
+    return os.environ.get(_WS_TOKEN_ENV, "").strip()
+
+
+def _presented_token(ws: WebSocket | None = None, request: Request | None = None) -> str:
+    """Token from either place a browser can supply one on a WebSocket.
+
+    A browser cannot set headers on `new WebSocket()`, so the token rides in the
+    subprotocol list instead: `new WebSocket(url, ["realtime", "token.<T>"])`.
+    Non-browser clients may use `Authorization: Bearer <T>` or `?token=<T>`,
+    which is also what `curl` and the probe scripts use.
+    """
+    headers = ws.headers if ws is not None else request.headers
+    auth = headers.get("authorization", "")
+    if auth.lower().startswith("bearer "):
+        return auth[7:].strip()
+    for protocol in (ws.headers.get("sec-websocket-protocol", "") if ws is not None else "").split(","):
+        protocol = protocol.strip()
+        if protocol.startswith("token."):
+            return protocol[len("token."):]
+    params = ws.query_params if ws is not None else request.query_params
+    return params.get("token", "").strip()
+
+
+def _check_ws_access(ws: WebSocket) -> str | None:
+    """None when allowed, else the reason to close with (no token is echoed)."""
+    expected = _ws_token()
+    if not expected:
+        return None
+    if hmac.compare_digest(_presented_token(ws), expected):
+        return None
+    return "unauthorized"
+
+
+def _check_http_access(request: Request) -> Response | None:
+    expected = _ws_token()
+    if not expected or hmac.compare_digest(_presented_token(request=request), expected):
+        return None
+    return Response(
+        content='{"error":{"message":"unauthorized","type":"invalid_request_error"}}',
+        status_code=401,
+        media_type="application/json",
+        headers={"WWW-Authenticate": "Bearer"},
+    )
+
+
