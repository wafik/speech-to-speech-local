+    def _resolve_session_voice(self, tts_input: TTSIn) -> str:
+        """Voice for this turn: the response's own request, else session.update, else the startup voice.
+
+        Supertonic did not read runtime_config at all, so a client's
+        session.update (audio.output.voice) was acknowledged and then ignored -
+        the reply kept the voice the server started with. Kokoro already
+        resolves it this way; this mirrors that, minus the model-specific bits.
+        """
+        requested = None
+        response = getattr(tts_input, "response", None)
+        audio = getattr(response, "audio", None)
+        output = getattr(audio, "output", None)
+        requested = getattr(output, "voice", None)
+
+        if not requested:
+            runtime_config = getattr(tts_input, "runtime_config", None)
+            session = getattr(runtime_config, "session", None) if runtime_config is not None else None
+            audio_cfg = getattr(session, "audio", None)
+            output_cfg = getattr(audio_cfg, "output", None)
+            requested = getattr(output_cfg, "voice", None)
+
+        if not requested:
+            return self.voice
+
+        name = str(requested).strip().upper()
+        if name not in SUPERTONIC_VOICES:
+            logger.warning(
+                "Ignoring Supertonic voice %r: not one of %s",
+                requested,
+                ", ".join(sorted(SUPERTONIC_VOICES)),
+            )
+            return self.voice
+        return name
+
+    def _response_voice_for(self, tts_input: TTSInput) -> str:
+        """Freeze the voice on the response's first sentence, reuse it for the rest.
+
+        `_resolve_session_voice` reads the live session config, which changes the
+        instant a session.update lands. With `-LowLatency` (one sentence per TTS
+        call) that would splice two voices into one answer, so the first
+        sentence of a response decides the voice for all of it.
+        """
+        key = tts_input.response_key
+        if key is None:
+            return self._resolve_session_voice(tts_input)
+        name = self._response_voice.get(key)
+        if name is None:
+            name = self._resolve_session_voice(tts_input)
+            if len(self._response_voice) > 8:  # bounded: a dropped end never leaks
+                self._response_voice.clear()
+            self._response_voice[key] = name
+        return name
+
+    def _voice_style(self, name: str):
+        """Style JSON is small, but cache it: a turn should not re-read it per sentence."""
+        style = self._style_cache.get(name)
+        if style is None:
+            style = self.tts.get_voice_style(voice_name=name)
+            self._style_cache[name] = style
+        return style
+
